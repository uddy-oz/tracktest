# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Discovery remains disabled unless both flags are explicitly enabled.
VITE_ENABLE_CATALOG_DISCOVERY=false
VITE_ENABLE_APPLE_MUSIC_CATALOG=false

# Server-only Apple Music catalog credentials. Never prefix these with VITE_.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_BASE64=
APPLE_MUSIC_STOREFRONT=us

# Optional alternative to server-side key signing. Treat this as a server secret.
# APPLE_MUSIC_DEVELOPER_TOKEN=
