{
  "name": "stanzer",
  "private": true,
  "version": "0.0.0",
  "description": "StanZer - Prove you're a superfan with album quizzes, live Duels, and Party Mode.",
  "type": "module",
  "scripts": {
    "test:history-clock": "node --experimental-strip-types --test tools/history-clock.test.ts",
    "test:achievement-permanence": "node --experimental-strip-types --test tools/achievement-permanence.test.ts",
    "test:badge-vault": "node --experimental-strip-types --test tools/badge-vault.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:arena-rounds": "node --experimental-strip-types tools/arena-round-lifecycle.test.ts",
    "test:arena-start": "node --experimental-strip-types --test tools/arena-lobby-start.test.ts",
    "test:arena-audio": "node --experimental-strip-types --test tools/arena-audio-reliability.test.ts",
    "test:arena-ready-ack": "node --experimental-strip-types --test tools/arena-ready-ack.test.ts",
    "test:arena-clock": "node --experimental-strip-types --test tools/arena-clock.test.ts",
    "test:arena-question-set": "node --test tools/arena-question-set.test.mjs tools/arena-question-api.test.mjs",
    "test:party-mode": "node --experimental-strip-types --test tools/party-mode-reliability.test.ts",
    "test:arena-sql": "node tools/check-arena-sql.mjs",
    "test:arena-lifecycle-integration": "node --test tools/arena-lifecycle.integration.test.mjs",
    "test:arena-maintenance": "node tools/arena-maintenance.integration.test.mjs",
    "test:multiplayer-progression": "node --experimental-strip-types tools/multiplayer-progression.test.ts",
    "test:catalog": "node --experimental-strip-types --test tools/catalog-discovery.test.ts",
    "test:apple-catalog": "node --experimental-strip-types --test tools/apple-music-catalog.test.ts",
    "test:guest-identity": "node --experimental-strip-types --test tools/guest-identity.test.ts",
    "test:music-search": "node --experimental-strip-types --test tools/music-search.test.ts",
    "test:theme": "node --experimental-strip-types --test tools/theme-contrast.test.ts",
    "test:accessibility": "node --experimental-strip-types --test tools/accessibility-regression.test.ts",
    "test:mobile-ux": "node --experimental-strip-types --test tools/mobile-ux-regression.test.ts",
    "test:competitive-ui": "node --experimental-strip-types --test tools/competitive-ui-regression.test.ts",
    "test:frontend": "node --experimental-strip-types --test tools/frontend-maintainability.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "1.63.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "supabase": "2.122.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
