{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/prepare-arena-questions.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/((?:artists|albums)(?:/[a-z0-9-]+)?)/?", "dest": "/$1/index.html", "check": true },
    { "src": "/(?:artists|albums)(?:/.*)?", "dest": "/catalog-not-found.html", "status": 404 },
    { "src": "/api(?:/.*)?", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
